<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <AssemblyName>WasmChasm</AssemblyName>
    <RootNamespace>WasmChasm.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\WasmChasm.ico</ApplicationIcon>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\WasmChasm.Core\WasmChasm.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="NAudio.WinMM" Version="2.2.1" />
    <PackageReference Include="NAudio.Core" Version="2.2.1" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Fonts\VT323-Regular.ttf" />
    <Resource Include="Assets\WasmChasm.ico" />
    <!-- Compiled from Shaders\crt.fx by fxc.exe (Windows SDK); see README. Optional: the app falls back to overlay effects. -->
    <Resource Include="Shaders\crt.ps" Condition="Exists('Shaders\crt.ps')" />
    <None Include="Shaders\crt.fx" />
    <None Include="Fonts\OFL.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- One exe to download: every library goes inside it. App's static constructor loads them. -->
  <Target Name="BundleLibraries" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <EmbeddedResource Include="@(ReferenceCopyLocalPaths)" Condition="'%(ReferenceCopyLocalPaths.Extension)' == '.dll' And '%(ReferenceCopyLocalPaths.DestinationSubDirectory)' == ''">
        <LogicalName>bundled.%(ReferenceCopyLocalPaths.Filename)%(ReferenceCopyLocalPaths.Extension)</LogicalName>
      </EmbeddedResource>
    </ItemGroup>
  </Target>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>WasmChasm</AssemblyName>
    <RootNamespace>WasmChasm.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Single-file, self-contained x64 release build. -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\WasmChasm.Core\WasmChasm.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Fonts\VT323-Regular.ttf" />
    <!-- Compiled from Shaders\crt.fx by fxc.exe (Windows SDK); see README. Optional: the app falls back to overlay effects. -->
    <Resource Include="Shaders\crt.ps" Condition="Exists('Shaders\crt.ps')" />
    <None Include="Shaders\crt.fx" />
    <None Include="Fonts\OFL.txt" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>
</Project>

<Application x:Class="WasmChasm.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <!-- Palette. Single amber phosphor; brushes are swapped at runtime for Windows high contrast. -->
        <Color x:Key="PhosphorColor">#FFB000</Color>
        <Color x:Key="DimColor">#7A5400</Color>
        <Color x:Key="ScreenColor">#0E0B07</Color>
        <SolidColorBrush x:Key="Phosphor" Color="#FFB000" />
        <SolidColorBrush x:Key="Dim" Color="#7A5400" />
        <SolidColorBrush x:Key="ScreenBg" Color="#0E0B07" />

        <FontFamily x:Key="TerminalFont">pack://application:,,,/Fonts/#VT323</FontFamily>

        <Style x:Key="Term" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource TerminalFont}" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Foreground" Value="{DynamicResource Phosphor}" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        </Style>
        <Style x:Key="TermDim" TargetType="TextBlock" BasedOn="{StaticResource Term}">
            <Setter Property="Foreground" Value="{DynamicResource Dim}" />
        </Style>
        <Style x:Key="TermHeading" TargetType="TextBlock" BasedOn="{StaticResource Term}">
            <Setter Property="FontSize" Value="28" />
        </Style>

        <!-- Blinking: used for the cursor and warning headings. -->
        <Storyboard x:Key="BlinkStoryboard" RepeatBehavior="Forever">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity" Duration="0:0:1.06">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.53" Value="0" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
        <Style x:Key="Blink" TargetType="TextBlock" BasedOn="{StaticResource Term}">
            <Style.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard Storyboard="{StaticResource BlinkStoryboard}" />
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <!-- Inverse video block: amber background, screen-coloured text. -->
        <Style x:Key="InverseBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Phosphor}" />
            <Setter Property="Padding" Value="6,0" />
        </Style>
        <Style x:Key="InverseText" TargetType="TextBlock" BasedOn="{StaticResource Term}">
            <Setter Property="Foreground" Value="{DynamicResource ScreenBg}" />
        </Style>

        <!-- Text-only button used for the function-key legend and header switches. -->
        <Style x:Key="KeyButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Phosphor}" />
            <Setter Property="FontFamily" Value="{StaticResource TerminalFont}" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="Transparent" Padding="4,0">
                            <ContentPresenter x:Name="C" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource Phosphor}" />
                                <Setter TargetName="C" Property="TextElement.Foreground" Value="{DynamicResource ScreenBg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TermTextBox" TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource TerminalFont}" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Foreground" Value="{DynamicResource Phosphor}" />
            <Setter Property="CaretBrush" Value="{DynamicResource Phosphor}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource Phosphor}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="{DynamicResource Dim}" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style x:Key="TermScroll" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>

        <!-- Minimal amber scrollbar. -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10" />
            <Setter Property="MinWidth" Value="10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border BorderBrush="{DynamicResource Dim}" BorderThickness="1,0,0,0">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{DynamicResource Dim}" Margin="2,0,0,0" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>

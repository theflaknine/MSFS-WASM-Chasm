<Window x:Class="WasmChasm.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:WasmChasm.App.Views"
        Title="WASM Chasm"
        Icon="pack://application:,,,/Assets/WasmChasm.ico"
        Width="1100" Height="860" MinWidth="640" MinHeight="500"
        Background="#050403"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        PreviewKeyDown="OnPreviewKeyDown">
    <!-- The window letterboxes around a fixed 4:3 monitor. -->
    <Viewbox x:Name="Monitor" Stretch="Uniform" Margin="12">
        <Grid Width="1040" Height="800">
            <!-- Bezel: thick, rounded, matte plastic. -->
            <Border x:Name="Bezel" CornerRadius="46" BorderThickness="2" BorderBrush="#3A352E">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#2B2823" Offset="0" />
                        <GradientStop Color="#1E1C18" Offset="0.55" />
                        <GradientStop Color="#151310" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <!-- Light wear on the plastic, drawn in BezelWear.cs. It sits behind the screen and outside the shader. -->
                    <Image x:Name="WearLayer" Stretch="Fill" IsHitTestVisible="False">
                        <Image.Clip>
                            <RectangleGeometry Rect="0,0,1036,796" RadiusX="44" RadiusY="44" />
                        </Image.Clip>
                    </Image>
                    <!-- Inner recess around the glass. -->
                    <Border x:Name="ScreenFrame" Margin="34,30,34,50" CornerRadius="34" Background="#0A0907" BorderBrush="#0C0B09" BorderThickness="6">
                        <Grid x:Name="ScreenRoot" Width="952" Height="708" HorizontalAlignment="Center" VerticalAlignment="Center"
                              Background="{DynamicResource ScreenBg}">
                            <Grid.Clip>
                                <RectangleGeometry Rect="0,0,952,708" RadiusX="28" RadiusY="28" />
                            </Grid.Clip>

                            <!-- Everything lit by the phosphor lives in Glow (it receives the glow effect). -->
                            <Grid x:Name="Glow" Margin="26,18,26,14">
                              <Grid x:Name="MainContent">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Header: app name, detected install, session clock. -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource InverseBorder}">
                                        <TextBlock Style="{StaticResource InverseText}" Text="WASM CHASM" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button x:Name="InstallButton" Style="{StaticResource KeyButton}"
                                                Click="OnSwitchInstallClick" AutomationProperties.Name="Detected install. Press F2 to switch.">
                                            <TextBlock x:Name="InstallText" Text="INSTALL: ----" FontFamily="{DynamicResource TerminalFont}" FontSize="{DynamicResource TextSize}" Foreground="{DynamicResource Phosphor}" />
                                        </Button>
                                        <Button x:Name="ModeButton" Style="{StaticResource KeyButton}" Tag="F4" Click="OnLegendClick" Margin="24,0,0,0"
                                                AutomationProperties.Name="Display mode. Press F4 to switch between Fun and Serious.">
                                            <TextBlock x:Name="ModeText" Text="MODE: FUN  [F4]" FontFamily="{DynamicResource TerminalFont}" FontSize="{DynamicResource TextSize}" Foreground="{DynamicResource Phosphor}" />
                                        </Button>
                                    </StackPanel>
                                    <TextBlock x:Name="ClockText" Grid.Column="2" Style="{StaticResource Term}" Text="SESSION 00:00:00"
                                               AutomationProperties.Name="Session clock" />
                                </Grid>

                                <!-- Body -->
                                <Grid Grid.Row="1" Margin="0,8,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition x:Name="ChasmGapColumn" Width="16" />
                                        <ColumnDefinition x:Name="ChasmColumn" Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Grid.ColumnSpan="3" Height="1" VerticalAlignment="Top" Fill="{DynamicResource Dim}" />

                                    <!-- Ledger -->
                                    <DockPanel Grid.Column="0" Margin="0,8,0,0">
                                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Term}" FontSize="{DynamicResource TitleSize}" Text="SELECT AIRCRAFT TO PURGE" />
                                        <Grid DockPanel.Dock="Top" Margin="0,4,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource TermDim}" Text="FILTER&gt; " />
                                            <TextBox x:Name="FilterBox" Grid.Column="1" Style="{StaticResource TermTextBox}"
                                                     TextChanged="OnFilterChanged" AutomationProperties.Name="Filter aircraft by name" />
                                            <Button Grid.Column="2" Style="{StaticResource KeyButton}" Click="OnSortClick" Margin="12,0,0,0"
                                                    AutomationProperties.Name="Change sort order (F6)">
                                                <TextBlock x:Name="SortText" Text="SORT: NAME ▲" FontFamily="{DynamicResource TerminalFont}" FontSize="{DynamicResource TextSize}" />
                                            </Button>
                                        </Grid>
                                        <!-- Column headings -->
                                        <Grid DockPanel.Dock="Top" Margin="0,0,12,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="{DynamicResource SizeColumnWidth}" />
                                                <ColumnDefinition Width="{DynamicResource DateColumnWidth}" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="1" Style="{StaticResource TermDim}" Text="TITLE" />
                                            <TextBlock x:Name="SizeHeading" Grid.Column="2" Style="{StaticResource TermDim}" Text="CACHE" HorizontalAlignment="Right" Margin="0,0,20,0" />
                                            <TextBlock Grid.Column="3" Style="{StaticResource TermDim}" Text="MODIFIED" />
                                        </Grid>
                                        <!-- Running total (FR-6) and status line. -->
                                        <StackPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
                                            <Rectangle Height="1" Fill="{DynamicResource Dim}" Margin="0,0,0,2" />
                                            <TextBlock x:Name="TotalText" Style="{StaticResource Term}" Text="0 MARKED. 0 MB."
                                                       AutomationProperties.LiveSetting="Polite" />
                                            <TextBlock x:Name="StatusText" Style="{StaticResource TermDim}" Text="" TextTrimming="CharacterEllipsis"
                                                       AutomationProperties.LiveSetting="Polite" />
                                        </StackPanel>

                                        <Grid>
                                            <ListBox x:Name="Ledger"
                                                     SelectionMode="Multiple"
                                                     Background="Transparent" BorderThickness="0" Padding="0"
                                                     Foreground="{DynamicResource Phosphor}"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                     VirtualizingPanel.IsVirtualizing="False"
                                                     KeyboardNavigation.TabNavigation="Once"
                                                     AutomationProperties.Name="Aircraft list. Space marks an aircraft, Enter purges marked aircraft."
                                                     PreviewKeyDown="OnLedgerPreviewKeyDown"
                                                     SelectionChanged="OnLedgerSelectionChanged">
                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem">
                                                        <Setter Property="IsSelected" Value="{Binding IsMarked, Mode=TwoWay}" />
                                                        <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="ListBoxItem">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="18" />
                                                                            <ColumnDefinition Width="*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock x:Name="Cursor" Style="{StaticResource Blink}" Text="▶" Visibility="Hidden" VerticalAlignment="Top" />
                                                                        <Border x:Name="Bd" Grid.Column="1" Background="Transparent" Padding="2,0">
                                                                            <ContentPresenter x:Name="Cp" TextElement.Foreground="{DynamicResource Phosphor}" />
                                                                        </Border>
                                                                    </Grid>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                                                            <Setter TargetName="Cursor" Property="Visibility" Value="Visible" />
                                                                        </Trigger>
                                                                        <Trigger Property="IsSelected" Value="True">
                                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Phosphor}" />
                                                                            <Setter TargetName="Cp" Property="TextElement.Foreground" Value="{DynamicResource ScreenBg}" />
                                                                        </Trigger>
                                                                        <DataTrigger Binding="{Binding IsDetached}" Value="True">
                                                                            <Setter Property="Opacity" Value="0" />
                                                                        </DataTrigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel TextElement.FontFamily="{DynamicResource TerminalFont}" TextElement.FontSize="{DynamicResource TextSize}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="20" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="{DynamicResource SizeColumnWidth}" />
                                                                    <ColumnDefinition Width="{DynamicResource DateColumnWidth}" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Marker}" />
                                                                <TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Grid.Column="2" Text="{Binding SizeText}" HorizontalAlignment="Right" Margin="0,0,20,0" />
                                                                <TextBlock Grid.Column="3" Text="{Binding DateText}" />
                                                            </Grid>
                                                            <ItemsControl ItemsSource="{Binding SubRows}" Margin="20,0,0,0" Focusable="False">
                                                                <ItemsControl.Style>
                                                                    <Style TargetType="ItemsControl">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding ShowSubRows}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </ItemsControl.Style>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <TextBlock Text="{Binding Text}" Opacity="0.65" FontSize="{DynamicResource SmallSize}" TextTrimming="CharacterEllipsis" />
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <TextBlock x:Name="EmptyText" Style="{StaticResource TermDim}" Visibility="Collapsed" TextWrapping="Wrap"
                                                       Margin="20,12,0,0" Text="NO AIRCRAFT FOUND." />
                                        </Grid>
                                    </DockPanel>

                                    <!-- The chasm -->
                                    <views:ChasmView x:Name="Chasm" Grid.Column="2" Margin="0,8,0,0" />
                                </Grid>

                                <!-- Footer: function-key legend (clickable for mouse users). -->
                                <StackPanel Grid.Row="2">
                                    <Rectangle Height="1" Fill="{DynamicResource Dim}" Margin="0,0,0,2" />
                                    <WrapPanel x:Name="Legend" HorizontalAlignment="Center">
                                        <Button Style="{StaticResource LegendButton}" Content="F1: HELP" Tag="F1" Click="OnLegendClick" />
                                        <Button Style="{StaticResource LegendButton}" Content="F2: INSTALL" Tag="F2" Click="OnLegendClick" />
                                        <Button Style="{StaticResource LegendButton}" Content="F3: SETTINGS" Tag="F3" Click="OnLegendClick" />
                                        <Button Style="{StaticResource LegendButton}" Content="F5: RESCAN" Tag="F5" Click="OnLegendClick" />
                                        <Button Style="{StaticResource LegendButton}" Content="SPACE: SELECT" Tag="Space" Click="OnLegendClick" />
                                        <Button Style="{StaticResource LegendButton}" Content="ENTER: PURGE" Tag="Enter" Click="OnLegendClick" />
                                        <Button Style="{StaticResource LegendButton}" Content="ESC: CANCEL" Tag="Escape" Click="OnLegendClick" />
                                    </WrapPanel>
                                </StackPanel>

                              </Grid>

                                <!-- Full-screen sheet used for confirm, results, help, settings, pickers and notices.
                                     Transparent so the glow effect doesn't halo its edges; MainContent is hidden while it shows. -->
                                <Grid x:Name="Sheet" Background="Transparent" Visibility="Collapsed" Focusable="True" FocusVisualStyle="{x:Null}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel>
                                        <Border Style="{StaticResource InverseBorder}" HorizontalAlignment="Left">
                                            <TextBlock x:Name="SheetHeading" Style="{StaticResource InverseText}" FontSize="{DynamicResource HeadingSize}" Text="" />
                                        </Border>
                                        <Rectangle Height="1" Fill="{DynamicResource Dim}" Margin="0,6,0,6" />
                                    </StackPanel>
                                    <ScrollViewer x:Name="SheetScroll" Grid.Row="1" Style="{StaticResource TermScroll}" Focusable="False">
                                        <StackPanel x:Name="SheetBody" />
                                    </ScrollViewer>
                                    <StackPanel Grid.Row="2">
                                        <Rectangle Height="1" Fill="{DynamicResource Dim}" Margin="0,6,0,4" />
                                        <StackPanel x:Name="SheetPrompt" />
                                    </StackPanel>
                                </Grid>

                                <!-- The splash logo: shown briefly at launch. Any key or click skips it. -->
                                <Grid x:Name="Splash" Background="Transparent" Visibility="Collapsed"
                                      MouseDown="OnSplashMouseDown" AutomationProperties.Name="WASM Chasm">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock x:Name="SplashWasm" Text="WASM" FontFamily="{DynamicResource TerminalFont}" FontSize="170"
                                                   Foreground="{DynamicResource Phosphor}" HorizontalAlignment="Center" Margin="0,-30,0,-44" />
                                        <TextBlock x:Name="SplashChasm" Text="CHASM" FontFamily="{DynamicResource TerminalFont}" FontSize="170"
                                                   Foreground="{DynamicResource Phosphor}" HorizontalAlignment="Center" Margin="0,0,0,-14" />
                                        <Canvas Width="380" Height="104" HorizontalAlignment="Center">
                                            <Path Stroke="{DynamicResource Phosphor}" StrokeThickness="3" StrokeLineJoin="Miter"
                                                  Data="M 0,2 H 120 L 166,102 H 214 L 260,2 H 380" />
                                            <Path Stroke="{DynamicResource Phosphor}" StrokeThickness="2" Opacity="0.75" Data="M 129,22 H 251" />
                                            <Path Stroke="{DynamicResource Phosphor}" StrokeThickness="2" Opacity="0.5" Data="M 140,46 H 240" />
                                            <Path Stroke="{DynamicResource Phosphor}" StrokeThickness="2" Opacity="0.3" Data="M 151,72 H 229" />
                                        </Canvas>
                                        <TextBlock Style="{StaticResource TermDim}" Text="PURGES MSFS 2024 WASM DATA" FontSize="22"
                                                   HorizontalAlignment="Center" Margin="0,18,0,0" />
                                    </StackPanel>
                                </Grid>

                                <!-- Animation layer: rows sliding into the chasm and falling characters. -->
                                <Canvas x:Name="FxLayer" IsHitTestVisible="False" ClipToBounds="True" />
                            </Grid>

                            <!-- The power-on beam; only visible for the first moment after launch. -->
                            <Rectangle x:Name="PowerBeam" Fill="#FFE0A0" Visibility="Collapsed" IsHitTestVisible="False"
                                       RenderTransformOrigin="0.5,0.5" />

                            <!-- CRT overlays (hit-test invisible). -->
                            <Rectangle x:Name="ScanlineOverlay" IsHitTestVisible="False">
                                <Rectangle.Fill>
                                    <DrawingBrush TileMode="Tile" Viewport="0,0,4,3" ViewportUnits="Absolute" Viewbox="0,0,4,3" ViewboxUnits="Absolute">
                                        <DrawingBrush.Drawing>
                                            <DrawingGroup>
                                                <GeometryDrawing Brush="Transparent">
                                                    <GeometryDrawing.Geometry>
                                                        <RectangleGeometry Rect="0,0,4,3" />
                                                    </GeometryDrawing.Geometry>
                                                </GeometryDrawing>
                                                <GeometryDrawing Brush="#55000000">
                                                    <GeometryDrawing.Geometry>
                                                        <RectangleGeometry Rect="0,2,4,1" />
                                                    </GeometryDrawing.Geometry>
                                                </GeometryDrawing>
                                            </DrawingGroup>
                                        </DrawingBrush.Drawing>
                                    </DrawingBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <!-- The rectangle stays still and only its gradient moves. Moving the rectangle past the screen
                                 edge changes the area the CRT shader works on, which distorts the whole screen. -->
                            <Rectangle x:Name="RollBand" IsHitTestVisible="False">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,0.1695">
                                        <LinearGradientBrush.RelativeTransform>
                                            <TranslateTransform x:Name="RollTransform" Y="-0.1695" />
                                        </LinearGradientBrush.RelativeTransform>
                                        <GradientStop Color="#00FFB000" Offset="0" />
                                        <GradientStop Color="#0DFFB000" Offset="0.5" />
                                        <GradientStop Color="#00FFB000" Offset="1" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Rectangle x:Name="VignetteOverlay" IsHitTestVisible="False">
                                <Rectangle.Fill>
                                    <RadialGradientBrush RadiusX="0.75" RadiusY="0.75">
                                        <GradientStop Color="#00000000" Offset="0.55" />
                                        <GradientStop Color="#A0000000" Offset="1" />
                                    </RadialGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <!-- Faint glass reflection. -->
                            <!-- Fixed fills only, so nothing crosses the screen edge, and nothing moves, so it can't distract. -->
                            <Grid x:Name="GlassOverlay" IsHitTestVisible="False">
                                <Rectangle>
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#0CFFFFFF" Offset="0" />
                                            <GradientStop Color="#00FFFFFF" Offset="0.35" />
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <!-- A curved sheen across the upper left, with a soft inner edge, like a window behind the viewer. -->
                                <Rectangle>
                                    <Rectangle.Fill>
                                        <RadialGradientBrush Center="0.22,-0.42" GradientOrigin="0.22,-0.42" RadiusX="0.86" RadiusY="1.02">
                                            <GradientStop Color="#00FFF4E0" Offset="0.70" />
                                            <GradientStop Color="#0BFFF4E0" Offset="0.885" />
                                            <GradientStop Color="#03FFF4E0" Offset="0.94" />
                                            <GradientStop Color="#00FFF4E0" Offset="1" />
                                        </RadialGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <!-- A fainter bounce of light low on the right, where the tube curves away. -->
                                <Rectangle>
                                    <Rectangle.Fill>
                                        <RadialGradientBrush Center="0.94,1.06" GradientOrigin="0.94,1.06" RadiusX="0.42" RadiusY="0.40">
                                            <GradientStop Color="#0BFFF4E0" Offset="0" />
                                            <GradientStop Color="#00FFF4E0" Offset="1" />
                                        </RadialGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Bezel furniture: maker plate and power lamp. Anonymous by design. -->
                    <TextBlock x:Name="MakerPlate" Text="DATA TERMINAL  MODEL 24" Foreground="#5C564C" FontFamily="{DynamicResource TerminalFont}" FontSize="{DynamicResource SmallSize}"
                               HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="60,0,0,16" />
                    <StackPanel x:Name="PowerPanel" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,60,18">
                        <TextBlock Text="POWER" Foreground="#5C564C" FontFamily="{DynamicResource TerminalFont}" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <!-- An LED, so it's green rather than phosphor amber. Bright in the middle, with a soft glow around it. -->
                        <Ellipse x:Name="PowerLamp" Width="10" Height="10" Opacity="0.85">
                            <Ellipse.Fill>
                                <RadialGradientBrush GradientOrigin="0.42,0.38">
                                    <GradientStop Color="#C8FFD0" Offset="0" />
                                    <GradientStop Color="#3CE05A" Offset="0.55" />
                                    <GradientStop Color="#1E9A38" Offset="1" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#3CE05A" BlurRadius="16" ShadowDepth="0" Opacity="0.95" />
                            </Ellipse.Effect>
                        </Ellipse>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Viewbox>
</Window>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>WasmChasm.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Default copy embedded as a fallback; a locations.json beside the exe overrides it. -->
    <EmbeddedResource Include="..\..\data\locations.json" LogicalName="WasmChasm.Core.locations.json" />
    <None Include="..\..\data\locations.json" Link="locations.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="WasmChasm.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>
</Project>
